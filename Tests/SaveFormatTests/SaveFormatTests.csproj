<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SaveFormatTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The format layer is deliberately free of Unity and ECS types so the whole on-disk
         contract, including migration and corruption containment, is verifiable without the game. -->
    <Compile Include="../../Components/RestrictionByteCodec.cs" Link="RestrictionByteCodec.cs" />
    <Compile Include="../../Components/RouteFilterSaveData.cs" Link="RouteFilterSaveData.cs" />
    <Compile Include="../../Components/RestrictionEntryIdentity.cs" Link="RestrictionEntryIdentity.cs" />
    <Compile Include="../../Components/LegacyRouteFilterSaveData.cs" Link="LegacyRouteFilterSaveData.cs" />
  </ItemGroup>
</Project>
